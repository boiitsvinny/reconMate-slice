# Production API configuration. Never commit the real Supabase password.
APP_ENV=production
API_CORS_ORIGINS=https://recon-mate-slice.vercel.app
API_CORS_ORIGIN_REGEX=^https://recon-mate-slice-[a-z0-9]+-boiitsvinnys-projects\.vercel\.app$
# Supabase session pooler (port 5432) is compatible with Render's IPv4 network.
DATABASE_URL=postgresql://postgres.your-project-ref:your-url-encoded-password@aws-0-your-region.pooler.supabase.com:5432/postgres
AI_PROVIDER=mock
SIMULATION_TICK_INTERVAL_SECONDS=15
# Render provides PORT automatically. This value is only for a local production-style start.
PORT=8000
